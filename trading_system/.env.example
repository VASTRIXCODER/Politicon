# =========================================================================
#  HP Analytics Trading System -- environment configuration
#  Copy this file to `.env` and fill in your keys.  Never commit `.env`.
# =========================================================================

# -------------------------------------------------------------------------
#  SAFETY: trading mode.  "paper" = simulated money (default).  "live" places
#  REAL orders and must be set deliberately.
# -------------------------------------------------------------------------
TRADING_MODE=paper

#  Emergency kill switch.  Set to true to make the engine cancel all orders
#  and flatten all positions on its next loop, then stop.
KILL_SWITCH=false

# -------------------------------------------------------------------------
#  Broker / venue
# -------------------------------------------------------------------------
BROKER=alpaca

#  Alpaca API keys -- get them from https://app.alpaca.markets (use the PAPER
#  keys while TRADING_MODE=paper; the SDK selects the endpoint automatically).
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
#  Free market-data feed is "iex"; "sip" requires a paid subscription.
ALPACA_DATA_FEED=iex

#  Optional: Coinbase Advanced Trade (only used if BROKER=coinbase)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# -------------------------------------------------------------------------
#  Strategy
# -------------------------------------------------------------------------
#  1 = sign(high) * delta(open, 8)   (designed for the 1-day timeframe)
#  2 = RSI/rank comparison           (designed for the 1-hour timeframe)
EQUATION_SET=1
LOOKBACK_LENGTH=100
SIGNAL_VALUE=2

#  Universe + cadence. Leave TICKERS unset (commented out) to use the built-in
#  diverse default (~57 names across 9 sectors). Or set your own, comma-separated.
# TICKERS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,JPM,V,UNH,XOM,SPY,QQQ
#  Parallel workers for the multi-ticker scan (keeps a big universe fast).
SCAN_WORKERS=12
INTERVAL=1d
#  Market-data source: "yfinance" (free) or "alpaca"
DATA_SOURCE=yfinance

# -------------------------------------------------------------------------
#  Risk management
# -------------------------------------------------------------------------
MAX_POSITION_PCT=10
#  Optional per-ticker overrides (dash -> underscore), e.g.:
#  MAX_POSITION_PCT_AAPL=5
#  MAX_POSITION_PCT_BTC_USD=2
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=10
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=3
#  When the daily loss limit hits: false = stop new entries (keep stops live),
#  true = also flatten everything immediately.
FLATTEN_ON_DAILY_LOSS=false
#  Only enter trades while the equities market is open.
REQUIRE_MARKET_OPEN=true

# -------------------------------------------------------------------------
#  Signals-only mode (no broker) + web dashboard
#  Used by:  python main.py scan   and   python main.py web
# -------------------------------------------------------------------------
#  Notional account size used to size the suggested share counts.
ACCOUNT_SIZE=100000
#  Years of history used to compute each ticker's backtested "edge".
EDGE_YEARS=3
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_REFRESH_SECONDS=30

# -------------------------------------------------------------------------
#  Optional Claude AI briefing layer (OFF by default)
#  When on, adds a plain-English rationale + news/earnings risk-check to the
#  top buy signals. Does NOT improve the quant edge; costs per API call.
# -------------------------------------------------------------------------
AI_BRIEFING=false
ANTHROPIC_API_KEY=
#  Cheap, fast model is the sensible default for many per-ticker calls.
ANTHROPIC_MODEL=claude-haiku-4-5

# -------------------------------------------------------------------------
#  Infrastructure
# -------------------------------------------------------------------------
DB_PATH=trades.db
DASHBOARD_REFRESH_SECONDS=30
LOG_LEVEL=INFO
