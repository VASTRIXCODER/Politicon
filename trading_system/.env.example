# =========================================================================
#  HP Analytics Trading System -- environment configuration
#  Copy this file to `.env` and fill in your keys.  Never commit `.env`.
# =========================================================================

# -------------------------------------------------------------------------
#  SAFETY: trading mode.  "paper" = simulated money (default).  "live" places
#  REAL orders and must be set deliberately.
# -------------------------------------------------------------------------
TRADING_MODE=paper

#  Emergency kill switch.  Set to true to make the engine cancel all orders
#  and flatten all positions on its next loop, then stop.
KILL_SWITCH=false

# -------------------------------------------------------------------------
#  Broker / venue
# -------------------------------------------------------------------------
BROKER=alpaca

#  Alpaca API keys -- get them from https://app.alpaca.markets (use the PAPER
#  keys while TRADING_MODE=paper; the SDK selects the endpoint automatically).
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
#  Free market-data feed is "iex"; "sip" requires a paid subscription.
ALPACA_DATA_FEED=iex

#  Optional: Coinbase Advanced Trade (only used if BROKER=coinbase)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# -------------------------------------------------------------------------
#  Strategy
# -------------------------------------------------------------------------
#  1 = sign(high) * delta(open, 8)   (designed for the 1-day timeframe)
#  2 = RSI/rank comparison           (designed for the 1-hour timeframe)
EQUATION_SET=1
LOOKBACK_LENGTH=100
SIGNAL_VALUE=2

#  Universe + cadence. Leave TICKERS unset (commented out) to use the built-in
#  diverse default (~150 names across 13 sectors + ETFs). Or set your own,
#  comma-separated.
# TICKERS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,JPM,V,UNH,XOM,SPY,QQQ
#  Or pick a named watchlist (ignored if TICKERS is set):
#    default | all | megacap | semis | software | ai | dividend | etfs | crypto
# WATCHLIST=default
#  Parallel workers for the multi-ticker scan (keeps a big universe fast).
#  Bump this if you scan a very large universe (e.g. 16–24).
SCAN_WORKERS=12
#  INTERVAL is the BAR timeframe used to build signals (1m / 1h / 1d).
INTERVAL=1d
#  How often the auto-trade engine wakes to re-check signals AND enforce
#  stop-loss / take-profit against the latest price. DECOUPLED from the bar
#  timeframe above. Default 60. Set as low as 1 for a fast / day-trade feel
#  (2-5 is a sensible sweet spot). NOTE: on a 1d INTERVAL a faster loop mainly
#  speeds up EXITS -- entry signals only change when new bars form. For genuine
#  fast-paced day-trading, also shorten INTERVAL (e.g. 1h) and consider
#  AGGRESSIVE_MODE so it acts on more signals.
ENGINE_INTERVAL_SECONDS=60
#  Market-data source: "yfinance" (free) or "alpaca"
DATA_SOURCE=yfinance

# -------------------------------------------------------------------------
#  Risk management
# -------------------------------------------------------------------------
MAX_POSITION_PCT=10
#  Optional per-ticker overrides (dash -> underscore), e.g.:
#  MAX_POSITION_PCT_AAPL=5
#  MAX_POSITION_PCT_BTC_USD=2
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=10
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=3
#  When the daily loss limit hits: false = stop new entries (keep stops live),
#  true = also flatten everything immediately.
FLATTEN_ON_DAILY_LOSS=false
#  Only enter trades while the equities market is open.
REQUIRE_MARKET_OPEN=true

# -------------------------------------------------------------------------
#  Auto-trading policy (which dashboard signals the engine acts on)
#  Used by:  python main.py autotrade   (preview first: --dry-run, no keys)
# -------------------------------------------------------------------------
#  "strong" = only act on STRONG BUY (both equations agree) -- conservative.
#  "buy"    = act on BUY or STRONG BUY.
AUTOTRADE_SIGNAL=strong
#  Only enter when conviction >= this (0-100). 0 = off.
AUTOTRADE_MIN_CONVICTION=0
#  Only enter when price >= its 50-bar average (don't buy downtrends).
AUTOTRADE_REQUIRE_UPTREND=true

#  ATR-adaptive (volatility-based) risk. When true, stops/targets/sizing adapt
#  to each stock's recent Average True Range instead of fixed %. You can also
#  toggle this live from the dashboard. Sizing risks ATR_RISK_PCT of equity per
#  trade (capped by MAX_POSITION_PCT), with the ATR stop distance setting shares.
ATR_ADAPTIVE=false
ATR_PERIOD=14
ATR_STOP_MULT=2.0
ATR_TARGET_MULT=4.0
ATR_RISK_PCT=1.0

#  Aggressive / active mode: act on any BUY (not just STRONG BUY) and ignore the
#  uptrend filter -> more, lower-conviction trades. HIGHER RISK. Toggle in the UI too.
AGGRESSIVE_MODE=false
#  Day-trade mode = a fast-paced PRESET that bundles three of the settings above:
#  INTERVAL=1h + AGGRESSIVE_MODE=true + ENGINE_INTERVAL_SECONDS=3. Toggle it live
#  with the web UI button, or run:  python main.py autotrade --day-trade
#  Optional AI risk-gate: before a BUY, Claude checks for imminent event risk
#  (earnings/halt/news) and can VETO the trade. A safety filter only -- it does NOT
#  train or change the strategy. Needs ANTHROPIC_API_KEY.
AI_GATE=false

# -------------------------------------------------------------------------
#  Signals-only mode (no broker) + web dashboard
#  Used by:  python main.py scan   and   python main.py web
# -------------------------------------------------------------------------
#  Notional account size used to size the suggested share counts.
ACCOUNT_SIZE=100000
#  Years of history used to compute each ticker's backtested "edge".
EDGE_YEARS=3
WEB_HOST=127.0.0.1
WEB_PORT=5000
WEB_REFRESH_SECONDS=30

# -------------------------------------------------------------------------
#  Optional Claude AI briefing layer (OFF by default)
#  When on, adds a plain-English rationale + news/earnings risk-check to the
#  top buy signals. Does NOT improve the quant edge; costs per API call.
# -------------------------------------------------------------------------
AI_BRIEFING=false
#  ANTHROPIC_API_KEY also powers the in-app AI co-pilot (the floating "Ask AI"
#  panel + Cmd-K "Ask the AI co-pilot"). With no key, the co-pilot stays off and
#  says so; set the key and restart to switch it on.
ANTHROPIC_API_KEY=
#  Cheap, fast model is the sensible default for many per-ticker calls.
ANTHROPIC_MODEL=claude-haiku-4-5

# -------------------------------------------------------------------------
#  Authentication — optional single-tenant Supabase login gate (OFF by default)
#  When AUTH_ENABLED=true AND all three Supabase values are set, the whole web
#  UI sits behind a Supabase email/password login. The JWT secret stays on the
#  server (only the public anon key reaches the browser).
#  Find these in Supabase: Project Settings -> API (URL, anon key) and
#  Project Settings -> API -> JWT Settings (JWT secret).
# -------------------------------------------------------------------------
AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
#  Optional: restrict entry to specific emails (comma-separated). Empty = anyone
#  who can sign up via your Supabase project may enter.
AUTH_ALLOWED_EMAILS=
#  Set true to mark the session cookie Secure (required when serving over HTTPS).
AUTH_COOKIE_SECURE=false

# -------------------------------------------------------------------------
#  Infrastructure
# -------------------------------------------------------------------------
DB_PATH=trades.db
DASHBOARD_REFRESH_SECONDS=30
LOG_LEVEL=INFO
