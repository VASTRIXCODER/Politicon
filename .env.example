# Politicon environment. Copy to .env.local for local development; on Vercel set
# these per environment. README.md → "Environment variables" documents each one.
# NEXT_PUBLIC_* values are inlined into the build: set them before `npm run build`.
# Empty values mean "use the default".

# ── Supabase (required) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only and bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (required) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model id (default claude-sonnet-5-5). A model without a built-in price in
# lib/server/aiConfig.ts also needs AI_PRICE_INPUT_PER_MTOK / AI_PRICE_OUTPUT_PER_MTOK.
ANTHROPIC_MODEL=

# ── Official bill records ─────────────────────────────────────────────────────
# api.data.gov key for Congress.gov. Unset = the shared, heavily rate-limited
# DEMO_KEY (fine for local development, flagged by /api/health in production).
CONGRESS_API_KEY=
# Open States key. Unset = state bills are skipped and the site only mentions federal bills.
OPENSTATES_API_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash, e.g. https://getpoliticon.app. Used for link
# previews, robots.txt and sitemap.xml. A localhost value is ignored on Vercel,
# where the deployment's own URL is used instead.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Contact address shown on the site (default support@getpoliticon.app).
NEXT_PUBLIC_SUPPORT_EMAIL=
# Set to 1 to keep Vercel Web Analytics and Speed Insights off (they only load on Vercel).
NEXT_PUBLIC_ANALYTICS_DISABLED=

# ── Security and operations ───────────────────────────────────────────────────
# Secret for hashing client IPs in the rate limiter (any long random string).
RATE_LIMIT_SALT=
# Send as the x-health-token header to get per-dependency details from /api/health.
HEALTHCHECK_TOKEN=

# ── AI spend controls (optional) ──────────────────────────────────────────────
# 1 turns off every AI feature immediately (after a redeploy on Vercel).
AI_KILL_SWITCH=
# Comma-separated features to turn off: analyze,feed,advisor,advisor_policy,insight,cumulative_summary
AI_DISABLED_FEATURES=
# Rolling 24h dollar ceiling across all users (default 50).
AI_GLOBAL_DAILY_USD=
# Per-user rolling 24h call caps (defaults: analyze 10, feed 8, advisor 60,
# advisor_policy 30, insight 20, cumulative_summary 40).
AI_DAILY_LIMIT_ANALYZE=
AI_DAILY_LIMIT_FEED=
AI_DAILY_LIMIT_ADVISOR=
AI_DAILY_LIMIT_ADVISOR_POLICY=
AI_DAILY_LIMIT_INSIGHT=
AI_DAILY_LIMIT_CUMULATIVE_SUMMARY=
# Dollars per million tokens, used only for a model with no built-in price.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
