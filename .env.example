# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security
# Secret used to hash client IPs for rate limiting (any long random string).
RATE_LIMIT_SALT=
# Send as the x-health-token header to get per-dependency details from /api/health.
HEALTHCHECK_TOKEN=

# AI spend controls (all optional)
# Set to 1 to turn off every AI feature immediately.
AI_KILL_SWITCH=
# Comma-separated features to turn off: analyze,feed,advisor,advisor_policy,insight,cumulative_summary
AI_DISABLED_FEATURES=
# Rolling 24h dollar ceiling across all users (default 50).
AI_GLOBAL_DAILY_USD=50
# Per-user rolling 24h call caps, e.g. AI_DAILY_LIMIT_ANALYZE=10 (defaults in lib/server/aiGuard.ts).
AI_DAILY_LIMIT_ANALYZE=
# Pricing used to estimate cost in the usage ledger, in dollars per million tokens.
AI_PRICE_INPUT_PER_MTOK=3
AI_PRICE_OUTPUT_PER_MTOK=15
